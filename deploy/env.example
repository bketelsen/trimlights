# Copy to a private .env file. Never commit real deployment values.
TRIMLIGHT_IMAGE_TAG=main
# Bind to your TrueNAS LAN address when Caddy is on another machine.
TRIMLIGHT_BIND_ADDRESS=127.0.0.1
TRIMLIGHT_PORT=8787
TRIMLIGHT_DATA_PATH=/mnt/POOL/trimlights/data
TRIMLIGHT_CONFIG_PATH=/mnt/POOL/trimlights/config
# Keep empty until login and controller networking have been verified.
TRIMLIGHT_CONTROLLER_HOST=
TRIMLIGHT_TIMEZONE=UTC
# Set 3306 only for a privately validated compatible snapshot layout.
TRIMLIGHT_SCHEDULE_OFFSET=-1
